@model Mission06_Baird.Models.Movie
@{
    ViewData["Title"] = "Movie Added";
}

<div class="text-center">
    <h1 class="display-4">Success!</h1>
    <p>The movie <strong>@Model.Title</strong> has been added to the collection.</p>
    <div class="d-flex gap-3 justify-content-center">
        <a asp-action="MovieList" class="btn btn-secondary btn-action">View Collection</a>
        <a asp-action="EnterMovie" class="btn btn-primary btn-action">Add Another</a>
    </div>
</div>