@model Mission06_Baird.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container">
    <h2>Delete Movie</h2>

    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this movie?</h4>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@Model.Title (@Model.Year)</h5>
            <p><strong>Director:</strong> @Model.Director</p>
            <p><strong>Category:</strong> @Model.Category?.CategoryName</p>
            <p><strong>Rating:</strong> @Model.Rating</p>
            <p><strong>Edited:</strong> @(Model.Edited ? "Yes" : "No")</p>
            <p><strong>Copied to Plex:</strong> @(Model.CopiedToPlex ? "Yes" : "No")</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="movieId" value="@Model.MovieId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
    </form>
</div>
