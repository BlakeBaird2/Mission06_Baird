@model Mission06_Baird.Models.Movie

@{
    ViewData["Title"] = "Enter Movie";
}

<div class="container">
    <h2>Add a Movie to the Collection</h2>
    <form asp-controller="Home" asp-action="EnterMovie" method="post">
        
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <input asp-for="Category" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Year" class="form-label"></label>
            <input asp-for="Year" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Director" class="form-label"></label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <select asp-for="Rating" class="form-select">
                <option value="">Select a Rating</option>
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Edited" class="form-label">Edited?</label>
            <select asp-for="Edited" class="form-select">
                <option value="false">No</option>
                <option value="true">Yes</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="LentTo" class="form-label">Lent To</label>
            <input asp-for="LentTo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes (Max 25 chars)</label>
            <input asp-for="Notes" class="form-control" />
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Submit Movie</button>
        <div asp-validation-summary="All" class="text-danger"></div>
    </form>
</div>