@model IEnumerable<Mission06_Baird.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
    ViewData["ContainerClass"] = "main-container-wide";
}

<div>
    <h2 class="mb-4">Joel's Movie Collection</h2>

    <div class="d-flex justify-content-center align-items-center gap-3 mb-3">
        <a asp-action="EnterMovie" class="btn btn-primary">Add New Movie</a>

        <form asp-action="MovieList" method="get" style="max-width: none; margin: 0;">
            <select name="categoryId" id="categoryId" class="form-select" style="min-width: 220px;" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat.CategoryId"
                            selected="@(ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == cat.CategoryId ? "selected" : null)">
                        @cat.CategoryName
                    </option>
                }
            </select>
        </form>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Year</th>
                <th>Director</th>
                <th>Category</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Copied to Plex</th>
                <th>Lent To</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.Year</td>
                    <td>@movie.Director</td>
                    <td>@movie.Category?.CategoryName</td>
                    <td>@movie.Rating</td>
                    <td>@(movie.Edited ? "Yes" : "No")</td>
                    <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                    <td>@movie.LentTo</td>
                    <td>@movie.Notes</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@movie.MovieId"
                           class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@movie.MovieId"
                           class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
