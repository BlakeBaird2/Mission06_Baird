@model IEnumerable<Mission06_Baird.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
    ViewData["ContainerClass"] = "main-container-wide";
}

<div>
    <h2 class="mb-4">Joel's Movie Collection</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        @* Search bar — left side *@
        <form asp-action="MovieList" method="get" class="d-flex align-items-center gap-2" style="max-width: none; margin: 0;">
            @if (ViewBag.SelectedCategory != null)
            {
                <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategory" />
            }
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control toolbar-control" placeholder="Search movies..." style="min-width: 250px;" />
            <button type="submit" class="btn btn-outline-secondary toolbar-btn">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
            {
                <a asp-action="MovieList" asp-route-categoryId="@ViewBag.SelectedCategory" class="btn btn-outline-danger toolbar-btn">Clear</a>
            }
        </form>

        @* Buttons and filter — right side *@
        <div class="d-flex align-items-center gap-2">
            <form asp-action="MovieList" method="get" style="max-width: none; margin: 0;">
                @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
                {
                    <input type="hidden" name="searchString" value="@ViewBag.SearchString" />
                }
                <select name="categoryId" id="categoryId" class="form-select toolbar-control" style="min-width: 200px;" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.CategoryId"
                                selected="@(ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == cat.CategoryId ? "selected" : null)">
                            @cat.CategoryName
                        </option>
                    }
                </select>
            </form>

            <a asp-action="EnterMovie" class="btn btn-primary toolbar-btn text-nowrap">+ Add Movie</a>
        </div>
    </div>

    <table class="table table-striped table-bordered table-hover" style="table-layout: fixed; width: 100%;">
        <colgroup>
            <col style="width: 17%;" />   @* Title *@
            <col style="width: 5%;" />    @* Year *@
            <col style="width: 14%;" />   @* Director *@
            <col style="width: 9%;" />    @* Category *@
            <col style="width: 6%;" />    @* Rating *@
            <col style="width: 6%;" />    @* Edited *@
            <col style="width: 5%;" />    @* Plex *@
            <col style="width: 7%;" />    @* Lent To *@
            <col style="width: 8%;" />    @* Notes *@
            <col style="width: 12%;" />   @* Actions *@
        </colgroup>
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Year</th>
                <th>Director</th>
                <th>Category</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Plex</th>
                <th>Lent To</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td class="truncate-cell" title="@movie.Title">@movie.Title</td>
                    <td>@movie.Year</td>
                    <td class="truncate-cell" title="@movie.Director">@movie.Director</td>
                    <td class="truncate-cell" title="@movie.Category?.CategoryName">@movie.Category?.CategoryName</td>
                    <td>@movie.Rating</td>
                    <td>@(movie.Edited ? "Yes" : "No")</td>
                    <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                    <td class="truncate-cell" title="@movie.LentTo">@movie.LentTo</td>
                    <td class="truncate-cell" title="@movie.Notes">@movie.Notes</td>
                    <td>
                        <div class="d-flex gap-1 flex-nowrap">
                            <a asp-action="Edit" asp-route-id="@movie.MovieId"
                               class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@movie.MovieId"
                               class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
